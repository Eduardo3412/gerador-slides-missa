# Copie para .env e preencha. Nunca versione o .env real.

# Obrigatórias
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Opcionais
# AMBIENTE=development          # production ativa cookies Secure automaticamente
# COOKIE_SECURE=false           # sobrescreve o padrão do ambiente
# COOKIE_SAMESITE=lax           # lax | strict | none (none exige COOKIE_SECURE=true)
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Somente para testes (opcional; padrão: SQLite em memória). Nunca use o banco principal.
# TEST_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/gerador_slides_testes
